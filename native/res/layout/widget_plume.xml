<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/w_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Écrire une note…"
        android:textColor="#8E887E"
        android:textSize="16sp"
        android:paddingVertical="10dp"
        android:paddingHorizontal="14dp"
        android:background="@drawable/widget_pill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aujourd’hui"
            android:textColor="#F2A33A"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:id="@+id/w_tasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tâches"
            android:textColor="#F2A33A"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
