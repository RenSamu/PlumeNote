<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/a_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/a_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#EDE9E1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/a_dictate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dicter"
            android:textSize="13sp"
            android:textColor="#F2A33A"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@drawable/widget_pill" />

        <TextView
            android:id="@+id/a_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="+ Note"
            android:textSize="13sp"
            android:textColor="#F2A33A"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@drawable/widget_pill" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/a_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/a_t0"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#8E887E"
            android:maxLines="1" />

        <TextView
            android:id="@+id/a_x0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#EDE9E1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/a_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/a_t1"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#8E887E"
            android:maxLines="1" />

        <TextView
            android:id="@+id/a_x1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#EDE9E1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/a_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/a_t2"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#8E887E"
            android:maxLines="1" />

        <TextView
            android:id="@+id/a_x2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#EDE9E1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/a_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/a_t3"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#8E887E"
            android:maxLines="1" />

        <TextView
            android:id="@+id/a_x3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#EDE9E1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/a_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/a_t4"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#8E887E"
            android:maxLines="1" />

        <TextView
            android:id="@+id/a_x4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#EDE9E1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/a_row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/a_t5"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#8E887E"
            android:maxLines="1" />

        <TextView
            android:id="@+id/a_x5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#EDE9E1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/a_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="14sp"
        android:textColor="#8E887E" />

    <TextView
        android:id="@+id/a_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:textColor="#8E887E" />
</LinearLayout>
